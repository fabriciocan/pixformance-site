---
/**
 * Timed popup with the design A/B test (since 2026-11-05).
 * V1 = teal "Jetzt 60 Tage testen" with checks; V2 = dark "Neukunden-Special" with offer header.
 * Used by SitePopup (site-wide) and /lp. The host page wires the buttons via
 * [data-timed-popup="close|cta|decline"] and reports events through window.PixPopupDesign.track().
 * Events go to Pixformance Reports through /pr/ab (same origin, nginx proxies to the Reports
 * container); stats and reset live in Reports under "A/B-Tests" (since 2026-11-05, before that n8n).
 */
---

<div id="timed-popup" class="fixed inset-0 z-[9998] hidden items-center justify-center p-4" role="dialog" aria-modal="true">
  <div id="timed-popup-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- V1: teal -->
  <div data-popup-design="V1" class="pd-card relative hidden w-full max-w-sm max-h-[92vh] overflow-y-auto rounded-[1.75rem] bg-[#6BDBD1] shadow-2xl" aria-labelledby="pd-v1-title">
    <button data-timed-popup="close" aria-label="Schließen" class="pd-close absolute top-3 right-3 z-10">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="relative">
      <img
        src="/images/popup/popup-header-v1.webp"
        alt="Pixformance Stationen im Einsatz: ein Patient trainiert mit Medizinball vor der Station"
        class="block w-full aspect-[800/590] max-h-[34vh] object-cover object-[center_30%]"
        width="800"
        height="590"
        loading="lazy"
      />
      <a href="/newsletter/year-end-offer-2026-1-print" data-popup-newsletter="v1-badge" class="absolute left-4 -bottom-5 flex items-center gap-3 rounded-full bg-black py-1.5 pl-5 pr-1.5 shadow-lg transition-transform duration-200 hover:scale-[1.03]">
        <span class="font-display text-[0.8rem] font-bold uppercase tracking-[0.09em] text-white">Neukunden-Special <span class="text-[#6BDBD1]">2026</span></span>
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#6BDBD1] text-black" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14a8 8 0 0 1-8 8"/><path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1"/><path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10"/><path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg>
        </span>
      </a>
    </div>

    <div class="px-7 pt-10 pb-6 text-center">
      <p id="pd-v1-title" class="font-display text-[2.15rem] font-extrabold leading-[1.05] text-white">Jetzt 60 Tage<br />testen</p>

      <ul class="mx-auto mt-5 inline-flex flex-col gap-2.5 text-left">
        {['Unverbindlich', 'Kein monatliches Abo', 'Keine versteckten Kosten'].map((item) => (
          <li class="flex items-center gap-3 font-display text-base font-bold text-[#02308C]">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#02308C] text-white" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>

      <button data-timed-popup="cta" class="mt-6 w-full cursor-pointer rounded-2xl bg-white py-3.5 font-display text-lg font-bold text-[#02308C] shadow-md transition-shadow duration-200 hover:shadow-lg">
        » Unternehmen (weiter)
      </button>
      <button data-timed-popup="decline" class="mt-3 w-full cursor-pointer py-1 text-sm text-white underline underline-offset-2 transition-opacity hover:opacity-80">
        Privatperson (schließen)
      </button>
    </div>
  </div>

  <!-- V2: dark, Neukunden-Special -->
  <div data-popup-design="V2" class="pd-card relative hidden w-full max-w-sm max-h-[92vh] overflow-y-auto rounded-[1.75rem] bg-black shadow-2xl" aria-labelledby="pd-v2-title">
    <button data-timed-popup="close" aria-label="Schließen" class="pd-close absolute top-3 right-3 z-10">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="relative">
      <img
        src="/images/popup/popup-header-v2.webp"
        alt="Pixformance Neukunden-Special: Aktion gültig bis Ende November, Auslieferung noch in 2026"
        class="block w-full aspect-[800/590] max-h-[36vh] object-cover object-left"
        width="800"
        height="590"
        loading="lazy"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-black"></div>
    </div>

    <div class="px-7 pt-3 pb-6 text-center">
      <span class="inline-block rounded-xl bg-[#6BDBD1] px-5 py-1.5 font-display text-[0.8rem] font-bold uppercase tracking-[0.08em] text-black">Neukunden-Special 2026</span>

      <p id="pd-v2-title" class="mt-5 font-display text-[1.55rem] font-bold leading-[1.15] text-white">Training &amp; Therapie effizienter gestalten&nbsp;–</p>
      <p class="mt-2.5 font-display text-base font-semibold text-[#6BDBD1]">für Physiotherapie, Reha und Fitness.</p>

      <a href="/newsletter/year-end-offer-2026-1-print" data-popup-newsletter="v2-cta" data-popup-primary class="pd-glow mt-7 flex w-full cursor-pointer items-center justify-center gap-3 rounded-full bg-[#6BDBD1] py-3.5 font-display text-base font-extrabold uppercase tracking-[0.06em] text-black transition-transform duration-200 hover:scale-[1.02]">
        Angebot anfragen
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <button data-timed-popup="decline" class="mt-4 w-full cursor-pointer py-1 text-sm text-gray-400 underline underline-offset-2 transition-colors hover:text-gray-200">
        Privatperson (schließen)
      </button>
    </div>
  </div>
</div>

<style>
  .pd-close {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: #fff;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }
  .pd-glow {
    box-shadow: 0 0 28px rgba(107, 219, 209, 0.45);
  }
  #timed-popup.flex .pd-card:not(.hidden) {
    animation: pd-slide 0.3s ease-out;
  }
  @keyframes pd-slide {
    from { transform: translateY(20px) scale(0.97); }
    to   { transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    #timed-popup.flex .pd-card:not(.hidden) { animation: none; }
  }
</style>

<script is:inline>
(function () {
  var EVENT_URL = '/pr/ab';
  var KEYS = ['V1', 'V2'];
  var STORAGE_KEY = 'pix_popup_design';
  var params = new URLSearchParams(window.location.search);
  var override = (params.get('popup_design') || '').toUpperCase();
  // ?popup_design=V1|V2 forces a design for review and does not count in the stats.
  var isPreview = KEYS.indexOf(override) > -1;

  function pick() {
    if (isPreview) return override;
    try {
      var stored = localStorage.getItem(STORAGE_KEY);
      if (KEYS.indexOf(stored) > -1) return stored;
    } catch (e) {}
    var chosen = KEYS[Math.floor(Math.random() * KEYS.length)];
    try { localStorage.setItem(STORAGE_KEY, chosen); } catch (e) {}
    return chosen;
  }

  var variant = pick();
  document.querySelectorAll('[data-popup-design]').forEach(function (el) {
    el.classList.toggle('hidden', el.getAttribute('data-popup-design') !== variant);
  });
  document.querySelectorAll('[data-popup-design="' + variant + '"] img').forEach(function (img) {
    img.loading = 'eager';
  });

  function ss(key, value) {
    try {
      if (value === undefined) return sessionStorage.getItem(key);
      sessionStorage.setItem(key, value);
    } catch (e) { return null; }
  }

  function sessionId() {
    var id = ss('pix_popup_session_id');
    if (!id) {
      id = 'sess_' + Math.random().toString(36).slice(2) + Date.now();
      ss('pix_popup_session_id', id);
    }
    return id;
  }

  // eventType: view | click | close | lead | newsletter. A lead only counts if this session
  // opened the form through the popup CTA.
  function track(eventType) {
    if (eventType === 'lead' && ss('pix_popup_design_clicked') !== '1') return;
    if (eventType === 'click') ss('pix_popup_design_clicked', '1');
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'popup_design_' + eventType, popup_design: variant });
    if (isPreview) return;
    try {
      fetch(EVENT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          test: 'popup-design',
          event_type: eventType,
          variant: variant,
          session_id: sessionId(),
          page_path: window.location.pathname
        }),
        keepalive: true
      }).catch(function () {});
    } catch (e) {}
  }

  // Links pra newsletter (selo do V1, CTA do V2): UTMs dizem de qual popup e página veio.
  // A newsletter -print repassa os utm_* pros links dela, até a /year-end-offer, então o
  // lead chega no Zoho com utm_medium=popup. utm_term=header-1 mantém o visual da variação 1.
  var placement = /^\/lp(-v2)?\/?$/.test(window.location.pathname) ? 'lp' : 'site';
  document.querySelectorAll('[data-popup-newsletter]').forEach(function (a) {
    var u = new URL(a.getAttribute('href'), window.location.origin);
    u.searchParams.set('utm_source', 'pixformance-website');
    u.searchParams.set('utm_medium', 'popup');
    u.searchParams.set('utm_campaign', 'neukunden-special-2026');
    u.searchParams.set('utm_term', 'header-1');
    u.searchParams.set('utm_content', 'popup-' + placement + '-' + a.getAttribute('data-popup-newsletter'));
    a.href = u.pathname + u.search;
    a.addEventListener('click', function () {
      if (a.hasAttribute('data-popup-primary')) track('click');
      track('newsletter');
    });
  });

  window.PixPopupDesign = { variant: variant, track: track };
})();
</script>
