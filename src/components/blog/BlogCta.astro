---
/** Chamada final das páginas do blog: leva ao teste sem compromisso, como o resto do site. */
import { blogText, type BlogLocale } from '@/lib/blog';
import Button from '@/components/ui/form/Button/Button.astro';

interface Props {
  locale: BlogLocale;
}

const { locale } = Astro.props;
const t = blogText[locale];
---

<section class="bg-[#02308C] py-12 md:py-16">
  <div class="container">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center md:flex-row md:items-center md:justify-between md:text-left">
      <div class="space-y-2">
        <h2 class="text-2xl font-bold text-white md:text-3xl">{t.ctaTitle}</h2>
        <p class="text-sm text-white/80 md:text-base">{t.ctaText}</p>
      </div>
      <Button href={t.ctaHref} variant="secondary" size="lg" class="shrink-0">
        {t.ctaButton}
      </Button>
    </div>
  </div>
</section>
