---
/**
 * Página de um post, nas duas línguas. Recebe os dados já renderizados pela API
 * (HTML sanitizado, sumário, FAQ, relacionados) e monta o corpo no padrão do site.
 */
import { blogPaths, blogText, formatBlogDate, type BlogLocale, type BlogPost } from '@/lib/blog';
import BlogCard from './BlogCard.astro';
import BlogCover from './BlogCover.astro';
import BlogCta from './BlogCta.astro';
import '@/styles/blog.css';

interface Props {
  locale: BlogLocale;
  data: BlogPost;
}

const { locale, data } = Astro.props;
const { post, category, author, alternateSlug, related } = data;
const t = blogText[locale];
const other: BlogLocale = locale === 'en' ? 'de' : 'en';
---

<article>
  <header class="relative overflow-hidden bg-gradient-to-br from-[#6BDBD1]/20 to-[#02308C]/10 py-10 md:py-14">
    <div class="container">
      <div class="mx-auto max-w-3xl space-y-5">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs font-semibold text-foreground-muted">
          <a href={blogPaths.home(locale)} class="hover:text-[#02308C]">{t.blog}</a>
          {category && (
            <>
              <span aria-hidden="true">/</span>
              <a href={blogPaths.category(locale, category.slug)} class="hover:text-[#02308C]">{category.name}</a>
            </>
          )}
        </nav>

        <h1 class="text-3xl font-bold leading-tight text-foreground md:text-4xl lg:text-[2.75rem] text-left">{post.title}</h1>
        <p class="text-base leading-relaxed text-foreground-secondary md:text-lg text-left">{post.excerpt}</p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-foreground-muted">
          {author && <span class="font-semibold text-foreground">{author.name}</span>}
          {author && <span aria-hidden="true">·</span>}
          <time datetime={post.publishedAt ?? undefined}>{formatBlogDate(post.publishedAt, locale)}</time>
          <span aria-hidden="true">·</span>
          <span>{t.readingTime(post.readingMinutes)}</span>
          {alternateSlug && (
            <>
              <span aria-hidden="true">·</span>
              <a href={blogPaths.post(other, alternateSlug)} hreflang={other} class="font-semibold text-[#02308C] hover:underline">
                {t.otherLanguage}
              </a>
            </>
          )}
        </div>
      </div>
    </div>
  </header>

  {post.coverUrl && (
    <div class="container mt-8">
      <div class="mx-auto aspect-[16/7] max-w-4xl overflow-hidden rounded-xl">
        <BlogCover post={post} eager />
      </div>
    </div>
  )}

  <div class="container py-10 md:py-14">
    <div class="mx-auto max-w-3xl">
      {post.toc.length > 2 && (
        <nav aria-label={t.toc} class="mb-10 rounded-xl border border-border bg-gray-50 p-5">
          <p class="text-xs font-bold uppercase tracking-wider text-[#02308C]">{t.toc}</p>
          <ol class="mt-3 space-y-2 text-sm">
            {post.toc.map((entry, index) => (
              <li class="flex gap-2">
                <span class="w-6 shrink-0 font-semibold text-foreground-muted">{String(index + 1).padStart(2, '0')}</span>
                <a href={`#${entry.id}`} class="text-foreground hover:text-[#02308C]">{entry.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="blog-article" set:html={post.html} />

      {post.faq.length > 0 && (
        <section class="mt-14">
          <h2 class="text-2xl font-bold text-foreground text-left">{t.faq}</h2>
          <div class="mt-5 divide-y divide-border border-y border-border">
            {post.faq.map((item) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-foreground">
                  {item.question}
                  <span class="shrink-0 text-[#02308C] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-[15px] leading-relaxed text-foreground-secondary text-left">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {post.keywords.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2" aria-label="Keywords">
          {post.keywords.map((keyword) => (
            <li class="rounded-full bg-gray-100 px-3 py-1 text-xs text-foreground-muted">{keyword}</li>
          ))}
        </ul>
      )}

      {author && (
        <aside class="mt-12 flex gap-4 rounded-xl border border-border bg-white p-5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#02308C]/10 text-lg font-bold text-[#02308C]" aria-hidden="true">
            {author.name.charAt(0)}
          </div>
          <div>
            <p class="font-bold text-foreground">{author.name}</p>
            {author.roleTitle && <p class="text-sm text-foreground-muted">{author.roleTitle}</p>}
            {author.bio && <p class="mt-2 text-sm leading-relaxed text-foreground-secondary text-left">{author.bio}</p>}
          </div>
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl">
        <h2 class="text-2xl font-bold text-foreground text-left">{t.related}</h2>
        <div class="mt-6 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <BlogCard post={item} locale={locale} />
          ))}
        </div>
      </section>
    )}
  </div>
</article>

<BlogCta locale={locale} />
