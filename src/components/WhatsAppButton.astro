---
// Botão flutuante de WhatsApp — canto inferior direito.
// O ChatWidget está desativado (display:none), então o canto está livre.
// z-index 9990: acima do conteúdo, abaixo do SitePopup (9998/9999) e do CookieBanner (999999).

interface Props {
  /** Número no formato internacional, só dígitos. */
  phone?: string;
  /** Mensagem pré-preenchida na conversa. */
  message?: string;
  /** Texto do rótulo que aparece no hover (desktop). */
  label?: string;
}

const {
  phone = '491736266981',
  message = 'Ich möchte mehr über Pixformance erfahren.',
  label = 'Schreiben Sie uns',
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  id="whatsapp-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Kontakt über WhatsApp aufnehmen"
  data-wa-phone={phone}
>
  <span class="wa-label" aria-hidden="true">{label}</span>
  <span class="wa-icon">
    <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M16.004 3.2c-7.06 0-12.8 5.74-12.803 12.797a12.75 12.75 0 0 0 1.94 6.79L3.2 28.8l6.19-1.9a12.79 12.79 0 0 0 6.61 1.81h.005c7.056 0 12.797-5.74 12.8-12.8a12.72 12.72 0 0 0-3.747-9.053A12.72 12.72 0 0 0 16.004 3.2Zm0 23.06h-.004a10.63 10.63 0 0 1-5.42-1.484l-.389-.23-4.024 1.235 1.257-3.923-.253-.403a10.6 10.6 0 0 1-1.626-5.658c.002-5.867 4.776-10.64 10.646-10.64a10.57 10.57 0 0 1 7.522 3.121 10.57 10.57 0 0 1 3.114 7.527c-.003 5.868-4.777 10.64-10.646 10.64Zm5.84-7.97c-.32-.16-1.893-.934-2.187-1.04-.293-.107-.507-.16-.72.16-.213.32-.826 1.04-1.013 1.253-.187.213-.373.24-.693.08-.32-.16-1.351-.498-2.573-1.588-.951-.848-1.593-1.895-1.78-2.215-.187-.32-.02-.493.14-.652.144-.144.32-.373.48-.56.16-.187.213-.32.32-.533.107-.213.053-.4-.027-.56-.08-.16-.72-1.735-.986-2.375-.26-.624-.524-.54-.72-.55l-.613-.01c-.213 0-.56.08-.853.4-.293.32-1.12 1.094-1.12 2.669 0 1.574 1.147 3.095 1.307 3.308.16.213 2.257 3.446 5.468 4.832.764.33 1.36.527 1.825.674.767.244 1.464.21 2.016.127.615-.092 1.893-.774 2.16-1.521.267-.747.267-1.387.187-1.521-.08-.133-.293-.213-.613-.373Z"/>
    </svg>
  </span>
</a>

<style>
  #whatsapp-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9990;
    display: flex;
    align-items: center;
    gap: 0;
    height: 56px;
    padding: 0;
    border-radius: 9999px;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
    transition: box-shadow 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  #whatsapp-float:hover {
    background: #1fb855;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
  }

  #whatsapp-float:active {
    transform: translateY(0);
  }

  #whatsapp-float:focus-visible {
    outline: 3px solid #02308c;
    outline-offset: 3px;
  }

  .wa-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex: 0 0 56px;
  }

  /* Rótulo só no desktop, revelado no hover/foco */
  .wa-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    opacity: 0;
    transition: max-width 0.25s ease, opacity 0.2s ease, padding 0.25s ease;
    padding-left: 0;
  }

  @media (min-width: 768px) and (hover: hover) {
    #whatsapp-float:hover .wa-label,
    #whatsapp-float:focus-visible .wa-label {
      max-width: 12rem;
      opacity: 1;
      padding-left: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #whatsapp-float,
    .wa-label {
      transition: none;
    }
    #whatsapp-float:hover {
      transform: none;
    }
  }
</style>

<script is:inline>
  // Evento para o GTM (dataLayer) — mesma convenção das outras interações do site.
  document.addEventListener('click', function (e) {
    var link = e.target instanceof Element ? e.target.closest('#whatsapp-float') : null;
    if (!link) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'whatsapp_click',
      whatsapp_phone: link.getAttribute('data-wa-phone'),
      page_path: window.location.pathname,
      event_id: window.__metaEventId,
    });
  });
</script>
