---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Popup Design A/B Test" noindex={true} noSitePopup={true}>
  <main class="max-w-4xl mx-auto px-4 py-16">
    <a href="/tests/" class="text-sm text-[#02308C] hover:underline">&larr; Alle Tests</a>
    <h1 class="font-display text-2xl font-bold text-[#02308C] mb-2 mt-2">Popup Design A/B Test</h1>
    <p class="text-gray-500 text-sm mb-6">
      Zwei Designs des Timed-/Exit-Popups, 50/50 verteilt, auf der Website und auf /lp. Seit 05.11.2026.
      Vorschau: <a class="text-[#02308C] underline" href="/?popup_design=V1">V1</a> ·
      <a class="text-[#02308C] underline" href="/?popup_design=V2">V2</a> (Vorschau zählt nicht in die Statistik).
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="p-4 rounded-2xl border border-gray-200">
        <div class="font-bold text-[#02308C]">V1 · Türkis</div>
        <p class="text-sm text-gray-500 mt-1">„Jetzt 60 Tage testen“, Neukunden-Special-Badge, Checks Unverbindlich / Kein monatliches Abo / Keine versteckten Kosten, Button „Unternehmen (weiter)“.</p>
      </div>
      <div class="p-4 rounded-2xl border border-gray-200">
        <div class="font-bold text-[#02308C]">V2 · Dunkel</div>
        <p class="text-sm text-gray-500 mt-1">Header „Aktion gültig bis Ende November / Auslieferung noch in 2026“, „Training &amp; Therapie effizienter gestalten“, Button „Angebot anfragen“.</p>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div id="placement-filter" class="inline-flex rounded-lg border border-gray-200 p-0.5 text-sm">
        <button data-placement="all" class="px-3 py-1.5 rounded-md font-bold cursor-pointer">Alle</button>
        <button data-placement="site" class="px-3 py-1.5 rounded-md font-bold cursor-pointer">Website</button>
        <button data-placement="lp" class="px-3 py-1.5 rounded-md font-bold cursor-pointer">/lp</button>
      </div>
      <button id="refresh-btn" class="px-4 py-2 bg-[#02308C] text-white text-sm font-bold rounded-lg hover:bg-[#02308C]/90 cursor-pointer">
        Aktualisieren
      </button>
      <span id="updated-at" class="text-xs text-gray-400"></span>
    </div>

    <div id="stats-loading" class="text-gray-500 text-sm">Lade Daten...</div>
    <div id="stats-error" class="hidden text-red-600 text-sm"></div>

    <div class="overflow-x-auto">
      <table id="stats-table" class="hidden w-full border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-gray-200 text-left text-gray-500">
            <th class="py-2 pr-4">Variante</th>
            <th class="py-2 pr-4 text-right">Views</th>
            <th class="py-2 pr-4 text-right">Klicks</th>
            <th class="py-2 pr-4 text-right">Schließen</th>
            <th class="py-2 pr-4 text-right">Leads</th>
            <th class="py-2 pr-4 text-right">Klickrate</th>
            <th class="py-2 pr-4 text-right">Schließrate</th>
            <th class="py-2 pr-4 text-right">Lead-Rate</th>
          </tr>
        </thead>
        <tbody id="stats-body"></tbody>
      </table>
    </div>
    <p id="significance" class="hidden mt-4 text-sm text-gray-600"></p>

    <div id="chart-section" class="hidden mt-12">
      <h2 class="font-display text-lg font-bold text-gray-900 mb-1">Klickrate pro Tag</h2>
      <p class="text-sm text-gray-500 mb-4">Tägliche Klickrate (Klicks / Views) je Variante. Leads sind pro Tag zu wenige für eine eigene Kurve.</p>
      <div id="chart-root" class="viz-root"></div>
    </div>
  </main>
</BaseLayout>

<style>
  .viz-root {
    color-scheme: light;
    --surface-1: #fcfcfb;
    --text-primary: #0b0b0b;
    --text-secondary: #52514e;
    --text-muted: #8a8a86;
    --grid-line: #e7e6e1;
    --series-v1: #2a78d6;
    --series-v2: #e87ba4;
  }
  #placement-filter button[aria-pressed="true"] { background: #02308C; color: #fff; }
  #placement-filter button[aria-pressed="false"] { color: #02308C; }
  .viz-legend { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
  .viz-legend-item { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-secondary); }
  .viz-legend-key { width: 14px; height: 2px; border-radius: 1px; }
  .viz-tooltip {
    position: absolute; pointer-events: none; background: var(--surface-1);
    border: 1px solid var(--grid-line); border-radius: 8px; padding: 8px 10px; font-size: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12); color: var(--text-primary); z-index: 10; white-space: nowrap;
  }
  .viz-tooltip-date { color: var(--text-secondary); margin-bottom: 4px; font-weight: 600; }
  .viz-tooltip-row { display: flex; align-items: center; gap: 6px; }
  .viz-tooltip-key { width: 10px; height: 2px; flex-shrink: 0; }
  .viz-tooltip-value { font-weight: 700; }
  .viz-tooltip-label { color: var(--text-secondary); }
</style>

<script is:inline>
(function () {
  var STATS_URL = 'https://webhook.pixformance.com/webhook/popup-design-stats';
  var VARIANTS = ['V1', 'V2'];
  var VARIANT_VARS = { V1: '--series-v1', V2: '--series-v2' };
  var data = null;
  var placement = 'all';

  function fmt(n) { return new Intl.NumberFormat('de-DE').format(n); }
  function pct(a, b) { return b > 0 ? Math.round((a / b) * 10000) / 100 : 0; }
  function pctText(v) { return String(v).replace('.', ',') + '%'; }
  function matches(r) { return placement === 'all' || r.placement === placement; }

  function summarize() {
    var by = {};
    VARIANTS.forEach(function (v) { by[v] = { variant: v, views: 0, clicks: 0, closes: 0, leads: 0 }; });
    (data.totals || []).filter(matches).forEach(function (r) {
      if (!by[r.variant]) return;
      by[r.variant].views += r.views; by[r.variant].clicks += r.clicks;
      by[r.variant].closes += r.closes; by[r.variant].leads += r.leads;
    });
    return VARIANTS.map(function (v) {
      var s = by[v];
      s.ctr = pct(s.clicks, s.views); s.close_rate = pct(s.closes, s.views); s.lead_rate = pct(s.leads, s.views);
      return s;
    });
  }

  // Two-proportion z-test on click rate; returns confidence (0-100) that the rates differ.
  function confidence(a, b) {
    if (!a.views || !b.views) return null;
    var p1 = a.clicks / a.views, p2 = b.clicks / b.views;
    var p = (a.clicks + b.clicks) / (a.views + b.views);
    var se = Math.sqrt(p * (1 - p) * (1 / a.views + 1 / b.views));
    if (!se) return null;
    var z = Math.abs(p1 - p2) / se;
    var t = 1 / (1 + 0.2316419 * z);
    var d = 0.3989423 * Math.exp(-z * z / 2);
    var tail = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
    return Math.round((1 - 2 * tail) * 1000) / 10;
  }

  function renderTable(rows) {
    var body = document.getElementById('stats-body');
    body.innerHTML = '';
    var best = rows.slice().sort(function (a, b) { return b.lead_rate - a.lead_rate || b.ctr - a.ctr; })[0];
    rows.forEach(function (v) {
      var isBest = best && v === best && v.views > 0 && (v.clicks > 0 || v.leads > 0);
      var tr = document.createElement('tr');
      tr.className = 'border-b border-gray-100';
      var strong = isBest ? ' text-[#02308C]' : '';
      tr.innerHTML =
        '<td class="py-2 pr-4 font-bold' + strong + '">' + v.variant + (isBest ? ' 🏆' : '') + '</td>' +
        '<td class="py-2 pr-4 text-right">' + fmt(v.views) + '</td>' +
        '<td class="py-2 pr-4 text-right">' + fmt(v.clicks) + '</td>' +
        '<td class="py-2 pr-4 text-right">' + fmt(v.closes) + '</td>' +
        '<td class="py-2 pr-4 text-right font-bold' + strong + '">' + fmt(v.leads) + '</td>' +
        '<td class="py-2 pr-4 text-right font-bold' + strong + '">' + pctText(v.ctr) + '</td>' +
        '<td class="py-2 pr-4 text-right text-gray-500">' + pctText(v.close_rate) + '</td>' +
        '<td class="py-2 pr-4 text-right">' + pctText(v.lead_rate) + '</td>';
      body.appendChild(tr);
    });

    var sig = document.getElementById('significance');
    var c = confidence(rows[0], rows[1]);
    sig.classList.remove('hidden');
    if (c === null) {
      sig.textContent = 'Noch zu wenige Daten für eine Aussage.';
    } else {
      sig.textContent = 'Sicherheit, dass sich die Klickraten wirklich unterscheiden: ' + String(c).replace('.', ',') + ' %' +
        (c >= 95 ? ' (ab 95 % gilt das Ergebnis als belastbar).' : ' (belastbar erst ab 95 %, bitte weiterlaufen lassen).');
    }
  }

  function renderLineChart(root) {
    root.innerHTML = '';
    var daily = (data.daily || []).filter(matches);
    var days = Array.from(new Set(daily.map(function (d) { return d.day; }))).sort();
    if (!days.length) {
      var empty = document.createElement('p');
      empty.className = 'text-sm text-gray-400';
      empty.textContent = 'Noch keine Daten für die Tagesansicht.';
      root.appendChild(empty);
      return;
    }
    var series = {};
    VARIANTS.forEach(function (v) {
      series[v] = days.map(function (day) {
        var views = 0, clicks = 0;
        daily.forEach(function (d) { if (d.day === day && d.variant === v) { views += d.views; clicks += d.clicks; } });
        return views > 0 ? pct(clicks, views) : null;
      });
    });

    var legend = document.createElement('div');
    legend.className = 'viz-legend';
    VARIANTS.forEach(function (v) {
      var item = document.createElement('div');
      item.className = 'viz-legend-item';
      item.innerHTML = '<span class="viz-legend-key" style="background:var(' + VARIANT_VARS[v] + ')"></span><span>Variante ' + v + '</span>';
      legend.appendChild(item);
    });
    root.appendChild(legend);

    var wrap = document.createElement('div');
    wrap.style.position = 'relative';
    root.appendChild(wrap);

    var W = Math.max(320, root.clientWidth || 600), H = 280;
    var padL = 36, padR = 12, padT = 12, padB = 28;
    var plotW = W - padL - padR, plotH = H - padT - padB;
    var all = [];
    VARIANTS.forEach(function (v) { series[v].forEach(function (r) { if (r !== null) all.push(r); }); });
    var maxRate = Math.max(5, all.length ? Math.max.apply(null, all) : 5) * 1.2;
    var xStep = days.length > 1 ? plotW / (days.length - 1) : 0;
    function xPos(i) { return days.length > 1 ? padL + i * xStep : padL + plotW / 2; }
    function yPos(r) { return padT + plotH - (r / maxRate) * plotH; }

    var NS = 'http://www.w3.org/2000/svg';
    function el(name, attrs) { var e = document.createElementNS(NS, name); for (var k in attrs) e.setAttribute(k, attrs[k]); return e; }
    var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, width: '100%', height: H });
    svg.style.display = 'block'; svg.style.overflow = 'visible';

    for (var t = 0; t <= 4; t++) {
      var rv = (maxRate / 4) * t, y = yPos(rv);
      svg.appendChild(el('line', { x1: padL, x2: W - padR, y1: y, y2: y, stroke: 'var(--grid-line)', 'stroke-width': 1 }));
      var lab = el('text', { x: padL - 8, y: y + 4, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--text-muted)' });
      lab.textContent = Math.round(rv) + '%';
      svg.appendChild(lab);
    }
    var every = Math.max(1, Math.ceil(days.length / 7));
    days.forEach(function (day, i) {
      if (i % every !== 0 && i !== days.length - 1) return;
      var lab = el('text', { x: xPos(i), y: H - 8, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--text-muted)' });
      lab.textContent = new Date(day + 'T00:00:00').toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' });
      svg.appendChild(lab);
    });

    VARIANTS.forEach(function (v) {
      var color = 'var(' + VARIANT_VARS[v] + ')', d = '', drawing = false;
      series[v].forEach(function (r, i) {
        if (r === null) { drawing = false; return; }
        d += (drawing ? ' L ' : ' M ') + xPos(i) + ' ' + yPos(r); drawing = true;
      });
      if (d) svg.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: color, 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }));
      series[v].forEach(function (r, i) {
        if (r === null) return;
        svg.appendChild(el('circle', { cx: xPos(i), cy: yPos(r), r: 6, fill: 'var(--surface-1)' }));
        svg.appendChild(el('circle', { cx: xPos(i), cy: yPos(r), r: 4, fill: color }));
      });
    });

    var cross = el('line', { y1: padT, y2: padT + plotH, stroke: 'var(--text-muted)', 'stroke-width': 1, opacity: 0 });
    svg.appendChild(cross);
    var hit = el('rect', { x: padL, y: padT, width: plotW, height: plotH, fill: 'transparent' });
    svg.appendChild(hit);
    wrap.appendChild(svg);

    var tip = document.createElement('div');
    tip.className = 'viz-tooltip';
    tip.style.display = 'none';
    wrap.appendChild(tip);

    hit.addEventListener('mousemove', function (e) {
      var rect = svg.getBoundingClientRect();
      var mx = (e.clientX - rect.left) * (W / rect.width);
      var i = days.length > 1 ? Math.round((mx - padL) / xStep) : 0;
      i = Math.max(0, Math.min(days.length - 1, i));
      var html = '<div class="viz-tooltip-date">' + new Date(days[i] + 'T00:00:00').toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit' }) + '</div>';
      VARIANTS.forEach(function (v) {
        var r = series[v][i];
        html += '<div class="viz-tooltip-row"><span class="viz-tooltip-key" style="background:var(' + VARIANT_VARS[v] + ')"></span><span class="viz-tooltip-value">' + (r === null ? '–' : pctText(r)) + '</span><span class="viz-tooltip-label">' + v + '</span></div>';
      });
      tip.innerHTML = html;
      tip.style.display = 'block';
      tip.style.left = Math.min(xPos(i) * (rect.width / W) + 12, rect.width - 140) + 'px';
      tip.style.top = '4px';
      cross.setAttribute('x1', xPos(i)); cross.setAttribute('x2', xPos(i)); cross.setAttribute('opacity', 1);
    });
    hit.addEventListener('mouseleave', function () { tip.style.display = 'none'; cross.setAttribute('opacity', 0); });
  }

  function render() {
    document.querySelectorAll('#placement-filter button').forEach(function (b) {
      b.setAttribute('aria-pressed', String(b.getAttribute('data-placement') === placement));
    });
    if (!data) return;
    document.getElementById('stats-loading').classList.add('hidden');
    document.getElementById('stats-table').classList.remove('hidden');
    document.getElementById('chart-section').classList.remove('hidden');
    renderTable(summarize());
    renderLineChart(document.getElementById('chart-root'));
    document.getElementById('updated-at').textContent = 'Stand: ' + new Date(data.generated_at).toLocaleString('de-DE');
  }

  function load() {
    document.getElementById('stats-loading').classList.remove('hidden');
    document.getElementById('stats-error').classList.add('hidden');
    fetch(STATS_URL)
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (json) { data = json; render(); })
      .catch(function (err) {
        document.getElementById('stats-loading').classList.add('hidden');
        var e = document.getElementById('stats-error');
        e.classList.remove('hidden');
        e.textContent = 'Fehler beim Laden der Daten: ' + err.message;
      });
  }

  document.querySelectorAll('#placement-filter button').forEach(function (b) {
    b.addEventListener('click', function () { placement = b.getAttribute('data-placement'); render(); });
  });
  document.getElementById('refresh-btn').addEventListener('click', load);
  render();
  load();
})();
</script>
