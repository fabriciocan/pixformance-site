---
import BaseLayout from '@/layouts/BaseLayout.astro';

const tests = [
  {
    name: 'Popup A/B Test',
    description: 'Exit-/Timed-Popup Headline (Varianten A/B/C) — Views, Klicks, CTR.',
    href: '/tests/popup',
    status: 'aktiv',
  },
  {
    name: '/lp Headline A/B Test',
    description: 'Hero-Headline auf der Landingpage (Varianten A/B/C) — Views, Formular-Öffnungen, Leads.',
    href: '/tests/lp-headline',
    status: 'aktiv',
  },
];
---

<BaseLayout title="A/B Tests" noindex={true} noSitePopup={true}>
  <main class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="font-display text-2xl font-bold text-[#02308C] mb-2">A/B Tests</h1>
    <p class="text-gray-500 text-sm mb-8">Übersicht aller laufenden und vergangenen A/B-Tests auf der Website.</p>

    <div class="space-y-4">
      {tests.map((t) => (
        <a
          href={t.href}
          class="block p-5 rounded-2xl border border-gray-200 hover:border-[#02308C]/40 hover:shadow-md transition-all duration-200"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <div class="font-bold text-[#02308C]">{t.name}</div>
              <p class="text-sm text-gray-500 mt-1">{t.description}</p>
            </div>
            <span class="shrink-0 text-xs font-bold px-2.5 py-1 rounded-full bg-[#6BDBD1]/20 text-[#02308C]">
              {t.status}
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
