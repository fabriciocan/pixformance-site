---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeaderWithDropdown from '@/components/layout/HeaderWithDropdown.astro';
import Footer from '@/components/layout/Footer.astro';
import PixformanceLogo from '@/components/PixformanceLogo.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

const testimonials = [
  {
    name: 'Gunter Hölig',
    role: 'Therapieleitung',
    company: 'Medical Park Bad Rodach',
    image: '/images/gunter-hoelig-pixformance.webp',
    quote: 'Wenn ein Patient für einen Moment seine Krankheit vergessen kann und einfach Spaß hat, dann ist das auch wertvoll.',
  },
  {
    name: 'Gabriele Buchstein',
    role: 'Leitende Physiotherapeutin',
    company: 'Sauerlandklinik Hachen',
    image: '/images/gabriele-buchstein-sauerlandklinik.webp',
    quote: 'Die Patienten sind begeistert und sehr motiviert. Davon profitieren auch wir als Therapeuten, da die Patienten dadurch besser und zielgerichteter ihre Übungen ausführen.',
  },
  {
    name: 'Swetlana Zimmermann & Claas Bickeböller',
    role: 'Physiotherapeutin & Inhaber',
    company: 'Schlossphysio Winterthur, Schweiz',
    image: '/images/swetlana-zimmermann-schlossphysio.webp',
    quote: 'Wir wollten ein ganzheitliches Trainingsgerät, welches möglichst viele Muskelgruppen und Bewegungsmuster bei der Sporttherapie abdecken kann. Vor allem die Flexibilität, welche man durch das digitale Trainingskonzept erhält, war für uns ein ausschlaggebender Punkt.',
  },
  {
    name: 'Volker Sutor',
    role: 'Inhaber',
    company: 'Physiotherapiezentren »Reha Rondell«',
    image: '/images/volker-sutor-pixformance.webp',
    quote: 'Ein gezieltes Gesundheitstraining mit dem virtuellen Trainer erhöht die Effizienz der Behandlung und schafft mehr Zeit für die eigentliche Betreuung meiner Patienten.',
  },
  {
    name: 'Heike Schaible',
    role: 'Inhaberin',
    company: 'Physiotherapie Praxis "Raum für Gesundheit"',
    image: '/images/heike-schaible-round.webp',
    quote: 'Ich will mit Pixformance einen zweiten Selbstzahlerbereich aufbauen und damit vor allem meinen Mitarbeitenden entgegenkommen und ihnen eine einfachere und abwechslungsreichere Arbeit bieten.',
  },
  {
    name: 'Axel-André Richter',
    role: 'Inhaber',
    company: 'Gesundheitspraxis Richter & Lopez',
    image: '/images/axel-andre-richter-lopez.webp',
    quote: 'Ich kann das neue Training ganz individuell für jeden unserer Patienten gestalten. Vom Leistungssportler bis zur Omi ist für jeden das Richtige dabei.',
  },
];

const clientLogos = [
  'Logo-Medical-Park.png',
  'Logo-Gesundheitsrondell-Reharondell.png',
  'Logo-Charite.png',
  'Logo-GiB-Gesundheit-in-Bewegung-1.png',
  'Logo-Therapiezentrum-Rombach.png',
  'Logo-Essink-Sportscentrum-1.png',
  'Logo-Femme-Fit-1.png',
  'Logo-MrsSporty-Mrs-Sporty.png',
];

const perspektiven = [
  {
    title: 'Für Therapeuten',
    text: 'Mehr Zeit für Befundung, individuelle Betreuung und komplexe therapeutische Aufgaben – während digitale Unterstützung wiederkehrende Abläufe wie Übungsanleitung und Dokumentation übernimmt.',
  },
  {
    title: 'Für Patienten',
    text: 'Mehr Sicherheit, Orientierung und Eigenständigkeit während des Trainings – durch Echtzeit-Feedback, das Fortschritte sofort sichtbar macht und zum Weitermachen motiviert.',
  },
  {
    title: 'Für Einrichtungen',
    text: 'Mehr Kapazität, standardisierte Abläufe und zusätzliche wirtschaftliche Möglichkeiten – ohne zusätzliches Personal einstellen zu müssen.',
  },
];

const vergleich = [
  {
    thema: 'Übungsanleitung und Korrektur',
    ohne: 'Therapeuten müssen Übungen wiederholt selbst demonstrieren. Korrekturen erfolgen nach manueller Sichtprüfung – und damit teils zeitverzögert.',
    mit: 'Unsere patentierte Technologie liefert digitale Bewegungsanleitung und intelligentes Echtzeit-Feedback. Das ergänzt die therapeutische Anleitung und entlastet Ihr Personal spürbar.',
  },
  {
    thema: 'Rollenverteilung und Zeitnutzung',
    ohne: 'Der Therapeut muss Übungen mehrfach zeigen, wiederholen und alle Ergebnisse manuell dokumentieren. Anpassungen erfolgen ausschließlich durch ihn.',
    mit: 'Digitales Echtzeit-Feedback ermöglicht die gleichzeitige Betreuung mehrerer Patienten – ohne zusätzliches Personal. Zeitersparnis: ca. 5–10 Minuten pro Patient.',
  },
  {
    thema: 'Dokumentation und Verlaufskontrolle',
    ohne: 'Übungsdurchführungen werden manuell beobachtet und dokumentiert – individuelle Unterschiede sind schwerer erfassbar, der Zeitaufwand steigt.',
    mit: 'Fortschritte werden automatisch getrackt und sind jederzeit über die Online-Plattform abrufbar – für Patient und Therapeut.',
  },
  {
    thema: 'Individualisierbarkeit der Übungspläne',
    ohne: 'Übungspläne sind meist standardisiert und schwer individuell anpassbar – oft liegen sie in ausgedruckter Form vor.',
    mit: 'Über 700 Übungen für Indikationen wie Orthopädie, Neurologie und Onkologie – individuell anpassbar für jedes Alter und Fitnesslevel.',
  },
  {
    thema: 'Selbstzahler-Angebote und Wirtschaftlichkeit',
    ohne: 'Ein Selbstzahlerbereich mit klassischen Trainingsgeräten oder Kursen erfordert hohen personellen, organisatorischen und finanziellen Aufwand.',
    mit: 'Ein Selbstzahlerbereich lässt sich ohne zusätzlichen Personalaufwand aufbauen oder erweitern – und wird so zu einer zusätzlichen, lukrativen Einnahmequelle.',
  },
];
---

<BaseLayout
  title="Das 360°-Pixformance-Konzept – Broschüre kostenlos downloaden | Pixformance"
  description="Digitale Bewegungstherapie, neu gedacht: Wie das 360°-Pixformance-Konzept Therapeuten entlastet, Patienten aktiviert und Gesundheitseinrichtungen stärkt. Jetzt Broschüre herunterladen."
  noindex={true}
  noSitePopup={true}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Das 360°-Pixformance-Konzept – Broschüre",
    "description": "Pixformance Broschüre zum 360°-Konzept: Station, Online-Plattform und WebApp – digitale Bewegungstherapie für Praxen, Rehazentren und Kliniken.",
    "url": "https://www.pixformance.com/lp-360-konzept",
    "isPartOf": {"@type": "WebSite", "url": "https://pixformance.com"}
  }}
>
  <HeaderWithDropdown slot="header" position="sticky">
    <PixformanceLogo slot="logo" />
  </HeaderWithDropdown>

  <!-- Hero Section -->
  <section class="bg-[#02308C] py-16 md:py-24">
    <div class="container">
      <div class="max-w-5xl mx-auto text-center space-y-4">
        <h1 class="font-display text-3xl md:text-5xl lg:text-6xl font-black text-white leading-tight uppercase hero-animate" style="animation-delay: 0.2s;">
          Digitale Bewegungstherapie,<br />neu gedacht.
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto hero-animate" style="animation-delay: 0.3s;">
          Wie das 360°-Pixformance-Konzept Therapeuten entlastet, Patienten aktiviert und Gesundheitseinrichtungen stärkt.
        </p>
      </div>
    </div>
  </section>

  <!-- Broschüre Download Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-6xl mx-auto">

        <!-- Left: Broschüre Cover -->
        <div class="flex items-center justify-center" data-scroll="slide-left">
          <div class="relative">
            <div class="absolute -inset-4 bg-[#02308C]/10 rounded-3xl blur-xl"></div>
            <img
              src="/images/broschuere-360-konzept.webp"
              alt="Broschüre: Das 360°-Pixformance-Konzept – Digitale Bewegungstherapie, neu gedacht"
              class="relative w-full h-auto max-h-[520px] object-contain rounded-lg drop-shadow-2xl"
              loading="eager"
              width="1000"
              height="1414"
            />
          </div>
        </div>

        <!-- Right: Content + CTA -->
        <div class="space-y-8" data-scroll="slide-right">
          <div class="space-y-3">
            <h2 class="font-display text-2xl md:text-3xl font-bold leading-tight text-gray-900">
              Was Sie in der Broschüre erfahren:
            </h2>
          </div>

          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                Wie <strong class="text-gray-900">Station, Online-Plattform und WebApp</strong> als ein vernetztes Konzept zusammenspielen
              </p>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                Der direkte Vergleich: <strong class="text-gray-900">Praxisalltag mit und ohne Pixformance</strong> – in 7 zentralen Prozessen
              </p>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                Wie <strong class="text-gray-900">PixFit AI</strong> individuelle Trainingspläne in Sekunden vorschlägt
              </p>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                Zwei <strong class="text-gray-900">Erfolgsgeschichten aus der Praxis</strong> – inklusive Aufbau des Selbstzahlerbereichs
              </p>
            </li>
          </ul>

          <div class="pt-2">
            <button
              id="download-brochure-btn"
              class="inline-flex items-center gap-3 px-8 py-4 bg-[#C12828] text-white font-bold text-lg rounded-full hover:bg-[#a02020] hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer uppercase tracking-wide"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Broschüre downloaden
            </button>
            <p class="text-sm text-gray-400 mt-3">Kostenlos & unverbindlich</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Download Form Modal -->
  <div id="download-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4">
    <div id="download-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto p-8 md:p-10">
      <button id="download-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors cursor-pointer">
        <Icon name="x" size="md" />
      </button>

      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#02308C]/10 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#02308C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-[#02308C] mb-2">
          Broschüre herunterladen
        </h2>
        <p class="text-foreground-muted text-sm">Füllen Sie das Formular aus und Sie erhalten die Broschüre zum 360°-Pixformance-Konzept sofort.</p>
      </div>

      <form id="download-form" class="space-y-4">
        <div>
          <label for="dl-firma" class="block text-sm font-bold mb-1 text-gray-700">Einrichtung / Firma <span class="text-red-500">*</span></label>
          <input type="text" id="dl-firma" name="company" required placeholder="z.B. Physiopraxis Muster" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#02308C]/30 focus:border-[#02308C] transition-all text-gray-900" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="dl-vorname" class="block text-sm font-bold mb-1 text-gray-700">Vorname <span class="text-red-500">*</span></label>
            <input type="text" id="dl-vorname" name="first_name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#02308C]/30 focus:border-[#02308C] transition-all text-gray-900" />
          </div>
          <div>
            <label for="dl-nachname" class="block text-sm font-bold mb-1 text-gray-700">Nachname <span class="text-red-500">*</span></label>
            <input type="text" id="dl-nachname" name="last_name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#02308C]/30 focus:border-[#02308C] transition-all text-gray-900" />
          </div>
        </div>
        <div>
          <label for="dl-email" class="block text-sm font-bold mb-1 text-gray-700">E-Mail <span class="text-red-500">*</span></label>
          <input type="email" id="dl-email" name="email" required placeholder="ihre.email@beispiel.de" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#02308C]/30 focus:border-[#02308C] transition-all text-gray-900" />
        </div>
        <div>
          <label for="dl-number" class="block text-sm font-bold mb-1 text-gray-700">Telefonnummer <span class="text-red-500">*</span></label>
          <div class="flex gap-2">
            <select id="dl-country" aria-label="Ländervorwahl" class="w-[92px] shrink-0 px-2 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#02308C]/30 focus:border-[#02308C] transition-all text-gray-900"></select>
            <input type="tel" id="dl-number" required placeholder="151 12345678" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#02308C]/30 focus:border-[#02308C] transition-all text-gray-900" />
            <input type="hidden" id="dl-e164" name="phone" />
          </div>
          <p id="dl-error" class="hidden text-red-500 text-xs mt-1"></p>
        </div>
        <div class="flex items-start gap-3 pt-2">
          <input type="checkbox" id="dl-privacy" name="privacy" required class="mt-1 w-5 h-5 rounded border-gray-300 text-[#02308C] focus:ring-[#02308C]/30" />
          <label for="dl-privacy" class="text-xs text-gray-600 leading-relaxed">
            Ich habe die <a href="/datenschutz" class="text-[#02308C] hover:underline font-bold">Datenschutzerklärung</a> gelesen und willige ein, dass die Pixformance Sports GmbH mir die Broschüre und weitere Informationen per E-Mail oder Telefon zusenden darf. Die Einwilligung kann jederzeit widerrufen werden.
          </label>
        </div>
        <div id="download-form-message" class="hidden"></div>
        <button type="submit" class="w-full py-4 bg-[#02308C] text-white font-bold text-lg rounded-xl hover:bg-[#021d54] hover:shadow-lg transition-all duration-300 cursor-pointer uppercase tracking-wide">
          Broschüre jetzt anfordern
        </button>
      </form>
    </div>
  </div>

  <!-- Stats Bar -->
  <section class="py-12 md:py-16 bg-[#02308C]">
    <div class="container">
      <div class="grid grid-cols-3 gap-4 md:gap-8 max-w-4xl mx-auto text-center">
        <div class="flex flex-col items-center space-y-2" data-scroll="fade-up">
          <div class="text-3xl md:text-5xl font-bold text-[#6BDBD1] whitespace-nowrap">2,5M+</div>
          <div class="text-xs md:text-sm text-white/70">Trainierende / Jahr</div>
        </div>
        <div class="flex flex-col items-center space-y-2" data-scroll="fade-up">
          <div class="text-3xl md:text-5xl font-bold text-[#6BDBD1] whitespace-nowrap">1.100+</div>
          <div class="text-xs md:text-sm text-white/70">Kliniken & Praxen</div>
        </div>
        <div class="flex flex-col items-center space-y-2" data-scroll="fade-up">
          <div class="text-3xl md:text-5xl font-bold text-[#6BDBD1] whitespace-nowrap">700+</div>
          <div class="text-xs md:text-sm text-white/70">Funktionelle Übungen</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Carousel -->
  <section class="py-8 md:py-12 bg-white border-b border-gray-100">
    <div class="container">
      <div class="clients-track-wrapper overflow-hidden">
        <div class="clients-track flex items-center gap-12">
          {[...Array(2)].map(() =>
            clientLogos.map((logo) => (
              <img
                src={`/images/clients/${logo}`}
                alt={logo.replace(/Logo-|-\d+\.png|\.png/g, ' ').trim()}
                class="h-[100px] md:h-[132px] w-auto max-w-[165px] md:max-w-[220px] object-contain opacity-70 hover:opacity-100 transition-all duration-300 shrink-0"
                loading="lazy"
                width="220"
                height="132"
              />
            ))
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Drei Perspektiven -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12" data-scroll="fade-up">
          <h2 class="font-display text-3xl md:text-3xl font-bold text-gray-900">
            Drei Perspektiven. Ein gemeinsamer Fortschritt.
          </h2>
          <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
            Der Wert digitaler Bewegungstherapie zeigt sich nicht allein in der Technologie – sondern im täglichen Zusammenspiel von Therapeuten, Patienten und digitalen Lösungen.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {perspektiven.map((p, i) => (
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center space-y-4" data-scroll="fade-up">
              <div class="w-14 h-14 mx-auto rounded-full bg-[#02308C]/10 flex items-center justify-center">
                {i === 0 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#02308C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                )}
                {i === 1 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#02308C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                )}
                {i === 2 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#02308C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
                )}
              </div>
              <h3 class="font-bold text-xl text-gray-900">{p.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Das 360°-Konzept -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16 items-center max-w-6xl mx-auto">
        <div class="space-y-6" data-scroll="slide-left">
          <h2 class="font-display text-2xl md:text-3xl font-bold leading-tight text-gray-900">
            Das ist Pixformance: unsere voll vernetzte Trainingslösung
          </h2>
          <p class="text-base md:text-lg text-gray-600 leading-relaxed">
            Entwickelt von Experten aus Wissenschaft, Technologie, Medizin und Fitness. Das 360°-Pixformance-Konzept besteht aus drei Bausteinen, die ineinandergreifen:
          </p>
          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base text-gray-600 leading-relaxed">
                <strong class="text-gray-900">Pixformance Station</strong> – freistehend, über 700 Übungen, virtueller Trainer. Die integrierte 2D-Full-HD-Kamera scannt während des Trainings 25 Körperpunkte und korrigiert in Echtzeit.
              </p>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base text-gray-600 leading-relaxed">
                <strong class="text-gray-900">Online-Plattform</strong> – maßgeschneiderte Trainingseinheiten für Einzelpersonen und Gruppen erstellen oder einen Expertenplan wählen. Die Bewegungsdaten unterstützen die Betreuung.
              </p>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#02308C] flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size="xs" class="text-white" />
              </div>
              <p class="text-base text-gray-600 leading-relaxed">
