---
/** Post do blog em alemão: /blog/<slug>. */
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import HeaderWithDropdown from '@/components/layout/HeaderWithDropdown.astro';
import Footer from '@/components/layout/Footer.astro';
import PixformanceLogo from '@/components/PixformanceLogo.astro';
import BlogPostView from '@/components/blog/BlogPostView.astro';
import { absolute, blogPaths, blogPost } from '@/lib/blog';

const { slug } = Astro.params;
const data = slug ? await blogPost('de', slug) : null;

if (!data) return new Response(null, { status: 404 });
if ('redirectTo' in data) return Astro.redirect(blogPaths.post('de', data.redirectTo), 301);

const { post, category, author, alternateSlug } = data;
const url = absolute(blogPaths.post('de', post.slug));
const title = `${post.metaTitle || post.title} | Pixformance Blog`;
const description = post.metaDescription || post.excerpt;
const image = post.coverUrl ? absolute(post.coverUrl) : undefined;
Astro.response.headers.set('Cache-Control', 'public, max-age=60');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  inLanguage: 'de-DE',
  datePublished: post.publishedAt ?? undefined,
  dateModified: post.updatedAt,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  wordCount: post.wordCount,
  keywords: post.keywords.join(', '),
  articleSection: category?.name,
  image: image ? [image] : undefined,
  author: author
    ? { '@type': 'Person', name: author.name, jobTitle: author.roleTitle ?? undefined }
    : { '@type': 'Organization', name: 'Pixformance Sports GmbH' },
  publisher: {
    '@type': 'Organization',
    name: 'Pixformance Sports GmbH',
    url: 'https://www.pixformance.com',
    logo: { '@type': 'ImageObject', url: 'https://www.pixformance.com/images/pix-favicon.png' },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://www.pixformance.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: absolute(blogPaths.home('de')) },
    ...(category
      ? [{ '@type': 'ListItem', position: 3, name: category.name, item: absolute(blogPaths.category('de', category.slug)) }]
      : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: post.title, item: url },
  ],
};

const faqLd = post.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  type="article"
  image={image}
  noSitePopup
  jsonLd={faqLd ? [articleLd, breadcrumbLd, faqLd] : [articleLd, breadcrumbLd]}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="de" href={url} />
    {alternateSlug && <link rel="alternate" hreflang="en" href={absolute(blogPaths.post('en', alternateSlug))} />}
    <link rel="alternate" hreflang="x-default" href={url} />
    {post.publishedAt && <meta property="article:published_time" content={post.publishedAt} />}
    <meta property="article:modified_time" content={post.updatedAt} />
  </Fragment>

  <HeaderWithDropdown slot="header" position="sticky">
    <PixformanceLogo slot="logo" />
  </HeaderWithDropdown>

  <BlogPostView locale="de" data={data} />

  <Footer slot="footer" />
</BaseLayout>
