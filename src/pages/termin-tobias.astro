---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeaderWithDropdown from '@/components/layout/HeaderWithDropdown.astro';
import Footer from '@/components/layout/Footer.astro';
import PixformanceLogo from '@/components/PixformanceLogo.astro';

// Agenda self-hosted (Cal.com) na VPS da Pixformance. Trocar para cal.pixformance.com
// quando o registro DNS existir.
const CAL_URL = 'https://cal.46.225.179.77.sslip.io';
const CAL_USER = 'tobias';
---

<BaseLayout
  title="Termin mit Tobias Baader | Pixformance"
  description="Buchen Sie direkt einen Termin mit Tobias Baader, COO bei Pixformance: Beratung zum Year-End Offer 2026 oder Online-Demo der Pixformance Station."
  noindex={true}
  noSitePopup={true}
>
  <HeaderWithDropdown slot="header" position="sticky">
    <PixformanceLogo slot="logo" />
  </HeaderWithDropdown>

  <section class="bg-[#02308C] py-10 md:py-14">
    <div class="container">
      <div class="max-w-3xl mx-auto flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
        <img
          src="/images/Tobias-Baader-Pixformance-avatar.jpg"
          alt="Tobias Baader, COO bei Pixformance"
          width="140"
          height="140"
          class="w-32 h-32 md:w-36 md:h-36 rounded-full object-cover border-4 border-white/30 shrink-0"
        />
        <div class="space-y-2 text-white">
          <p class="text-sm uppercase tracking-widest text-[#6BDBD1] font-semibold">Termin buchen</p>
          <h1 class="text-3xl md:text-4xl font-bold">Sprechen Sie mit Tobias Baader</h1>
          <p class="text-white/85 text-lg">
            COO bei Pixformance. Wählen Sie einen freien Termin für eine Beratung zum
            Year-End Offer 2026 oder eine Online-Demo der Pixformance Station.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-8 md:py-12">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <iframe
          src={`${CAL_URL}/${CAL_USER}?embed=true&theme=light`}
          title="Terminbuchung mit Tobias Baader"
          class="w-full rounded-2xl border border-gray-200"
          style="min-height: 820px;"
          loading="lazy"
          allow="payment"
        ></iframe>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
