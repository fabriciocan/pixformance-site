};
const NAMES = Object.keys(ICONS);
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

document.getElementById('defs').innerHTML = NAMES.map(n =>
  `<symbol id="i-${n}" viewBox="${ICONS[n].vb}">${ICONS[n].p.map(d => `<path d="${d}"/>`).join('')}</symbol>`).join('');

const inline = (n, cls = '') =>
  `<svg class="ico ${cls}" viewBox="${ICONS[n].vb}" aria-hidden="true">${ICONS[n].p.map(d => `<path pathLength="1" d="${d}"/>`).join('')}</svg>`;
const use = n => `<svg viewBox="${ICONS[n].vb}" aria-hidden="true"><use href="#i-${n}"/></svg>`;

const shell = (fx, extra = '') => `
  <div class="bar"><span>60 TAGE TESTEN – ANGEBOT GÜLTIG BIS 30.11.26</span><span class="pill">MEHR ERFAHREN</span></div>
  <div class="hero">
    <div class="blob a"></div><div class="blob b"></div>
    <div class="fx">${fx}</div>
    <div class="content">
      <img class="logo" src="${LOGO}" alt="Pixformance" width="900" height="124">
      <p class="headline">60 TAGE TESTEN.<br>UNVERBINDLICH.<br><b>OHNE RISIKO.</b></p>
      ${extra}
    </div>
  </div>`;

// 1: icons on both sides of the headline
const flank = [
  ['squat',   -34, '30%', 6.2, 1,   -6, 'tl', 7],
  ['bars',    -23, '74%', 3.6, .55,  5, 'm0', 9],
  ['heart',   -43, '78%', 4.2, .7,   8, 'bl', 8],
  ['dumbbell', 27, '24%', 4.4, .7, -14, 'tr', 8.5],
  ['five',     37, '62%', 6.4, 1,    4, 'br', 7.5],
  ['person',   24, '82%', 3.4, .5,  -4, 'm0', 10],
];
const v1 = shell(flank.map(([n, dx, y, s, o, r, m, t], i) =>
  `<div class="fl ${m}" style="--dx:${dx};--y:${y};--s:${s};--o:${o};--r:${r}deg;--i:${i};--t:${t}s"><div>${inline(n)}</div></div>`).join(''));

// 2: a row under the headline, one icon moves at a time
const acts = [['person','a-hop'],['dumbbell','a-curl'],['heart','a-beat'],['squat','a-squat'],['five','a-five'],['bars','a-bars']];
const v2 = shell('', `<div class="row">${acts.map(([n, a], i) =>
  `<div class="slot" style="--i:${i}"><div class="lit">${inline(n, a)}</div></div>`).join('')}</div>`);

// 3: two bands of large icons moving in opposite directions
const seq = k => Array.from({length: 42}, (_, i) => use(NAMES[(i * k + (k > 1 ? 3 : 0)) % NAMES.length])).join('');
const v3 = shell(`<div class="band t">${seq(1)}</div><div class="band u">${seq(3)}</div><div class="veil"></div>`);

// 4: icon pattern, lit by a light that follows the pointer
const v4 = shell(`<svg class="grid dim" aria-hidden="true"></svg><svg class="grid glow" aria-hidden="true"></svg><div class="veil"></div>`);

const VARIANTS = [
  ['v1', '1. Draw-in', 'The icons are drawn line by line beside the headline, fill in, then hover almost still. The quietest option.', v1],
  ['v2', '2. One at a time', 'A row under the headline. Each icon does its own move in turn: the lift, the heartbeat, the squat, the high five, the chart. Adds about 70 px of height.', v2],
  ['v3', '3. Moving bands', 'Large icons pass behind the headline in two directions. More presence, no extra height.', v3],
  ['v4', '4. Spotlight', 'A faint icon pattern fills the black. A turquoise light travels over it and follows the mouse or finger. The loudest option.', v4],
];

const board = document.getElementById('board');
board.innerHTML = VARIANTS.map(([id, t, d, html]) => `
  <section class="variant">
    <div class="wrap head"><div><h2>${t}</h2><p>${d}</p></div><button class="replay" id="replay-${id}" type="button">Replay</button></div>
    <div class="stage ${id}" id="${id}">${html}</div>
  </section>`).join('');

// start each one when it scrolls into view; Replay restarts it
const play = el => { el.classList.remove('play'); void el.offsetWidth; el.classList.add('play'); };
const seen = new WeakSet();
const visible = new Set();
const io = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { visible.add(e.target.id); if (!seen.has(e.target)) { seen.add(e.target); play(e.target); } }
  else visible.delete(e.target.id);
}), {threshold: .35});
VARIANTS.forEach(([id]) => {
  const el = document.getElementById(id);
  io.observe(el);
  document.getElementById('replay-' + id).addEventListener('click', () => play(el));
});

// 4: build the pattern and move the light
(() => {
  const stage = document.getElementById('v4'), hero = stage.querySelector('.hero');
  const grids = stage.querySelectorAll('.grid');
  let w = 0, h = 0;
  const build = () => {
    const r = hero.getBoundingClientRect();
    if (Math.abs(r.width - w) < 2 && Math.abs(r.height - h) < 2) return;
    w = r.width; h = r.height;
    const cell = w < 700 ? 54 : 78, size = cell * .42;
    const cols = Math.ceil(w / cell) + 1, rows = Math.ceil(h / cell) + 1;
    const ox = (w - cols * cell) / 2, oy = (h - rows * cell) / 2;
    let s = '';
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const n = NAMES[(x * 2 + y * 3) % NAMES.length];
      s += `<use href="#i-${n}" x="${(ox + x * cell + (cell - size) / 2).toFixed(1)}" y="${(oy + y * cell + (cell - size) / 2).toFixed(1)}" width="${size.toFixed(1)}" height="${size.toFixed(1)}"/>`;
    }
    grids.forEach(g => { g.setAttribute('viewBox', `0 0 ${w} ${h}`); g.innerHTML = s; });
  };
  build();
  new ResizeObserver(build).observe(hero);
  if (reduce) return;
  let cx = .72, cy = .4, tx = cx, ty = cy, held = 0;
  hero.addEventListener('pointermove', e => {
    const r = hero.getBoundingClientRect();
    tx = (e.clientX - r.left) / r.width; ty = (e.clientY - r.top) / r.height; held = performance.now() + 1800;
  });
  const tick = now => {
    requestAnimationFrame(tick);
    if (!visible.has('v4')) return;
    if (now > held) { const t = now / 1000; tx = .5 + .4 * Math.sin(t * .45); ty = .5 + .34 * Math.sin(t * .8 + 1); }
    cx += (tx - cx) * .07; cy += (ty - cy) * .07;
    hero.style.setProperty('--mx', (cx * 100).toFixed(2) + '%');
    hero.style.setProperty('--my', (cy * 100).toFixed(2) + '%');
  };
  requestAnimationFrame(tick);
})();
</script>

