---
// Preview interno: quatro opções de animação dos ícones no header da /lp.
// noindex, fora do sitemap e sem link interno. Sai do ar quando a opção for escolhida.
import '@fontsource-variable/montserrat';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>LP Header Motion</title>
</head>
<body>
<style is:inline>
/* Layout: a presentation board. Short notes in a narrow column, each followed by a
   full-width replica of the real /lp header (red bar + black hero) carrying one motion idea. */
:root{
  --page:#f2f5f4; --ink:#0e1514; --muted:#56635f; --line:#d3dcda; --btn:#0e1514; --btn-ink:#ffffff;
  --hero:#000000; --tq:#6BDBD1; --red:#dc2626; --white:#ffffff;
  --font:'Montserrat Variable',ui-sans-serif,system-ui,sans-serif;
  --out:cubic-bezier(.16,1,.3,1);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){--page:#111615;--ink:#e8eeed;--muted:#9aa7a4;--line:#2a3432;--btn:#e8eeed;--btn-ink:#0e1514;color-scheme:dark}
}
:root[data-theme="dark"]{--page:#111615;--ink:#e8eeed;--muted:#9aa7a4;--line:#2a3432;--btn:#e8eeed;--btn-ink:#0e1514;color-scheme:dark}

html{color-scheme:light dark}body{margin:0;background:var(--page);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.55}
.wrap{max-width:760px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.intro{padding-block:56px 8px}
.intro h1{font-size:clamp(1.9rem,4.5vw,2.75rem);line-height:1.1;font-weight:700;margin:0 0 14px;text-wrap:balance}
.intro p{margin:0;color:var(--muted);max-width:60ch}
.variant{padding-block:44px 0}
.variant:last-of-type{padding-bottom:72px}
.head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;padding-bottom:18px}
.head > div{min-width:0;flex:1 1 320px}
.head h2{font-size:1.25rem;font-weight:700;margin:0 0 4px;line-height:1.2}
.head p{margin:0;color:var(--muted);font-size:.95rem;max-width:58ch}
.replay{font:600 .85rem var(--font);background:var(--btn);color:var(--btn-ink);border:0;border-radius:999px;padding:10px 18px;cursor:pointer;transition:transform .14s ease}
.replay:active{transform:scale(.97)}
.replay:focus-visible{outline:3px solid var(--tq);outline-offset:3px}

/* ---------- replica of the real header ---------- */
.stage{background:var(--hero);color:var(--white)}
.bar{background:var(--red);color:var(--white);display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px 16px;padding:10px 12px;text-align:center;font-weight:700;font-size:clamp(.72rem,1.6vw,.875rem);letter-spacing:.02em}
.bar span.pill{background:var(--white);color:var(--red);border-radius:999px;padding:6px 16px;font-size:.75rem}
.hero{position:relative;overflow:hidden;background:var(--hero);container-type:inline-size;padding-block:clamp(1.75rem,3vw,2.5rem) clamp(1.5rem,3vw,3rem)}
.blob{position:absolute;border-radius:50%;pointer-events:none}
.blob.a{top:-80px;right:-80px;width:clamp(192px,27cqw,384px);aspect-ratio:1;background:rgba(107,219,209,.10)}
.blob.b{bottom:-128px;left:-128px;width:clamp(256px,35cqw,500px);aspect-ratio:1;background:rgba(107,219,209,.05)}
.content{position:relative;text-align:center;padding-inline:20px;z-index:2}
.logo{display:block;height:clamp(28px,2.6cqw,36px);width:auto;margin:0 auto clamp(24px,2.4cqw,32px)}
.headline{margin:0;font-weight:700;line-height:1.1;font-size:clamp(2.2rem,5cqw,3.5rem);color:var(--white)}
.headline b{font-weight:700;color:var(--tq)}
.fx{position:absolute;inset:0;pointer-events:none;z-index:1}
.ico{display:block;width:100%;height:100%;overflow:visible}
.ico path{fill:var(--tq)}

/* ---------- 1: draw-in ---------- */
.v1 .fl{position:absolute;left:calc(50% + var(--dx)*1cqw);top:var(--y);width:calc(var(--s)*1cqw);aspect-ratio:1;transform:translate(-50%,-50%);opacity:var(--o,1)}
.v1 .fl > div{width:100%;height:100%;transform:rotate(var(--r,0deg))}
.v1 .ico path{stroke:var(--tq);stroke-width:5;stroke-dasharray:1;stroke-dashoffset:0;stroke-opacity:0}
.v1.play .ico path{animation:draw 1.7s ease-in-out backwards;animation-delay:calc(var(--i)*130ms + .15s)}
.v1.play .fl > div{animation:bob var(--t,7s) ease-in-out infinite alternate;animation-delay:calc(var(--i)*-1.3s)}
@keyframes draw{0%{stroke-dashoffset:1;fill-opacity:0;stroke-opacity:1}62%{stroke-dashoffset:0;fill-opacity:0;stroke-opacity:1}100%{stroke-dashoffset:0;fill-opacity:1;stroke-opacity:0}}
@keyframes bob{from{transform:translateY(-7%) rotate(var(--r,0deg))}to{transform:translateY(7%) rotate(calc(var(--r,0deg) + 4deg))}}
@container (max-width:700px){
  .v1 .fl{width:30px;left:auto;top:auto;transform:none;opacity:.75}
  .v1 .fl.m0{display:none}
  .v1 .fl.tl{left:18px;top:22px}.v1 .fl.tr{right:18px;top:22px}
  .v1 .fl.bl{left:14px;bottom:16px}.v1 .fl.br{right:14px;bottom:16px}
}

/* ---------- 2: one icon at a time ---------- */
.v2 .row{display:flex;justify-content:center;gap:clamp(16px,3.2cqw,40px);margin-top:clamp(20px,2.6cqw,34px)}
.v2 .slot{width:clamp(30px,4.2cqw,50px);aspect-ratio:1}
.v2 .lit{width:100%;height:100%;opacity:.42}
.v2 .ico, .v2 .ico path{transform-box:fill-box;transform-origin:50% 50%}
.v2.play .slot{animation:rise .7s var(--out) backwards;animation-delay:calc(var(--i)*70ms + .2s)}
.v2.play .lit{animation:lit 9s ease infinite;animation-delay:calc(var(--i)*1.5s + 1s)}
.v2.play .ico, .v2.play .ico path{animation-duration:9s;animation-timing-function:ease-in-out;animation-iteration-count:infinite;animation-delay:calc(var(--i)*1.5s + 1s)}
@keyframes rise{from{opacity:0;transform:translateY(12px) scale(.95)}}
@keyframes lit{0%{opacity:.42}2%,15%{opacity:1}19%,100%{opacity:.42}}
.v2.play .a-hop{animation-name:hop}
.v2.play .a-curl{animation-name:curl}
.v2.play .a-beat{animation-name:beat}
.v2.play .a-squat{animation-name:squat;transform-origin:50% 100%}
.v2.play .a-five path:nth-child(3){animation-name:handL}
.v2.play .a-five path:nth-child(4){animation-name:handR}
.v2.play .a-five path:not(:nth-child(3)):not(:nth-child(4)){animation-name:spark}
.v2 .a-bars path:nth-child(-n+3){transform-origin:50% 100%}
.v2.play .a-bars path:nth-child(3){animation-name:grow}
.v2.play .a-bars path:nth-child(1){animation-name:grow;animation-delay:calc(var(--i)*1.5s + 1.12s)}
.v2.play .a-bars path:nth-child(2){animation-name:grow;animation-delay:calc(var(--i)*1.5s + 1.24s)}
@keyframes hop{0%,16%,100%{transform:none}5%{transform:translateY(-12%)}9%{transform:none}12%{transform:translateY(-5%)}}
@keyframes curl{0%,16%,100%{transform:none}4%{transform:rotate(-24deg)}8%{transform:rotate(18deg)}12%{transform:rotate(-9deg)}}
@keyframes beat{0%,13%,100%{transform:none}3%{transform:scale(1.18)}6%{transform:none}9%{transform:scale(1.12)}}
@keyframes squat{0%,16%,100%{transform:none}5%{transform:translateY(4%) scaleY(.84)}10%{transform:none}13%{transform:translateY(2%) scaleY(.92)}}
@keyframes handL{0%,9%,100%{transform:none}5%{transform:translate(-8%,3%) rotate(-8deg)}}
@keyframes handR{0%,9%,100%{transform:none}5%{transform:translate(12%,-4%) rotate(6deg)}}
@keyframes spark{0%,8%{opacity:0;transform:scale(.4)}10%{opacity:1;transform:scale(1.25)}14%,100%{opacity:1;transform:none}}
@keyframes grow{0%,12%,100%{transform:none}3%{transform:scaleY(.3)}}

/* ---------- 3: moving bands ---------- */
.v3 .fx{-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.v3 .band{position:absolute;left:0;display:flex;gap:clamp(34px,5cqw,64px);width:max-content;opacity:.3}
.v3 .band svg{width:clamp(54px,8cqw,104px);aspect-ratio:1;flex:none}
.v3 .band.t{top:8%}
.v3 .band.u{bottom:6%}
.v3 .band use{fill:var(--tq)}
.v3.play .band.t{animation:slideL 70s linear infinite}
.v3.play .band.u{animation:slideR 70s linear infinite}
.v3 .veil{position:absolute;inset:0;background:radial-gradient(ellipse 46% 78% at 50% 56%,rgba(0,0,0,.96) 0%,rgba(0,0,0,.88) 45%,rgba(0,0,0,0) 100%)}
.v3.play .fx{animation:fade 1.2s var(--out) backwards}
@keyframes slideL{to{transform:translateX(-50%)}}
@keyframes slideR{from{transform:translateX(-50%)}to{transform:none}}
@keyframes fade{from{opacity:0}}

/* ---------- 4: spotlight ---------- */
.v4 .hero{--mx:72%;--my:40%}
.v4 .fx{pointer-events:none}
.v4 .grid{position:absolute;inset:0;width:100%;height:100%}
.v4 .grid.dim use{fill:var(--white);fill-opacity:.07}
.v4 .grid.glow use{fill:var(--tq)}
.v4 .grid.glow{-webkit-mask-image:radial-gradient(circle clamp(120px,19cqw,250px) at var(--mx) var(--my),#000 0%,rgba(0,0,0,.55) 45%,transparent 100%);mask-image:radial-gradient(circle clamp(120px,19cqw,250px) at var(--mx) var(--my),#000 0%,rgba(0,0,0,.55) 45%,transparent 100%)}
.v4 .veil{position:absolute;inset:0;background:radial-gradient(ellipse 40% 70% at 50% 56%,rgba(0,0,0,.9) 0%,rgba(0,0,0,.7) 50%,rgba(0,0,0,0) 100%)}
.v4.play .fx{animation:fade 1.2s var(--out) backwards}

@media (prefers-reduced-motion: reduce){
  .stage *, .stage{animation:none !important}
}
</style>

<header class="intro wrap">
  <h1>Four ways to bring the icons into the /lp header</h1>
  <p>Same header as today: red bar, logo, headline, the two circles. Only the icon layer changes. They go from quiet to loud. Replay restarts the entrance of each one.</p>
</header>

