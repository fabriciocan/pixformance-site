---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Página própria da landing de e-mail Year-End Offer 2026 (pedido da Kati: não usar
// /lp nem /kontakt). Desde 30/09 segue o formato do concorrente: página preta, fora do
// site (sem header e footer), só as duas informações da oferta e um formulário de uma
// etapa. O agradecimento aparece na própria página. O select de Einrichtung é o mesmo
// do popup do site e da variante do teste A/B da /lp, e vai no campo `company`.
// A cor de destaque acompanha a variação do e-mail (utm_term=header-2 é dourada).
const EINRICHTUNGEN = [
  'Physiotherapie',
  'Therapie- / Rehazentrum',
  'Klinik / Krankenhaus',
  'Fitness- / Gesundheitszentrum',
  'Hotel / Wellness',
  'Pflegeeinrichtung',
  'Betriebliches Gesundheitsmanagement (BGM)',
  'Sonstiges',
];
const base = 'py-4 rounded-xl border-0 bg-white text-gray-900 focus:outline-none focus:ring-4 focus:ring-[var(--yeo-accent)]/40 transition-all';
const field = 'w-full min-w-0 px-4 py-4 rounded-xl border-0 bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-4 focus:ring-[var(--yeo-accent)]/40 transition-all';
---

<BaseLayout
  title="Year-End Offer 2026 – Special Offer anfragen | Pixformance"
  description="Verpassen Sie nicht unser Year-End Offer 2026: Aktion gültig bis Ende November, Auslieferung noch 2026. Jetzt unverbindlich anfragen."
  noindex={true}
  noSitePopup={true}
>
  <div id="yeo" class="min-h-screen bg-[#080808] text-white flex flex-col" style="--yeo-accent:#6BDBD1">
    <div class="flex-1 w-full max-w-xl mx-auto px-5 pt-6 pb-12 md:pt-8">
      <a href="/" class="block w-fit mx-auto mb-6" aria-label="Pixformance Startseite">
        <img src="/images/logo/logoWHITE.png" alt="Pixformance" width="150" height="34" class="w-[140px] h-auto" />
      </a>

      <p class="text-center text-xs font-bold tracking-[0.2em] uppercase text-[var(--yeo-accent)] mb-3">
        Year-End Offer 2026
      </p>
      <h1 class="text-center font-display text-base font-bold leading-snug mb-5 md:-mx-16">
        Sie erhalten von uns eine persönliche Rückmeldung mit dem passenden Angebot und den aktuellen Aktionskonditionen.
      </h1>

      <ul class="grid grid-cols-2 gap-3 mb-6">
        <li class="bg-white/5 border border-white/10 rounded-xl px-3 py-2.5 text-center">
          <p class="text-[11px] uppercase tracking-widest text-white/60">Aktion gültig bis</p>
          <p class="text-base font-bold">Ende November</p>
        </li>
        <li class="bg-white/5 border border-white/10 rounded-xl px-3 py-2.5 text-center">
          <p class="text-[11px] uppercase tracking-widest text-white/60">Auslieferung</p>
          <p class="text-base font-bold">Noch 2026</p>
        </li>
      </ul>

      <form id="yeo-form" class="space-y-4" novalidate>
        <input type="text" id="yeo-name" name="name" required autocomplete="name" placeholder="Ihr Name" aria-label="Ihr Name" class={field} />
        <input type="email" id="yeo-email" name="email" required autocomplete="email" placeholder="Ihre E-Mail-Adresse" aria-label="Ihre E-Mail-Adresse" class={field} />
        <div>
          <div class="flex gap-2">
            <select id="yeo-country" aria-label="Ländervorwahl" class={`${base} w-[96px] shrink-0 px-2`}></select>
            <input type="tel" id="yeo-number" required autocomplete="tel-national" placeholder="Ihre Telefonnummer" aria-label="Ihre Telefonnummer" class={field} />
            <input type="hidden" id="yeo-e164" name="phone" />
          </div>
          <p id="yeo-error" class="hidden text-red-400 text-xs mt-1"></p>
        </div>
        <div class="relative">
          <select id="yeo-einrichtung" name="company" required aria-label="Einrichtung" class={`${field} appearance-none cursor-pointer pr-12 invalid:text-gray-400`}>
            <option value="" disabled selected>Einrichtung</option>
            {EINRICHTUNGEN.map((e) => <option value={e} class="text-gray-900">{e}</option>)}
          </select>
          <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9l5-5 5 5M7 15l5 5 5-5"/></svg>
        </div>
        <textarea id="yeo-message" name="message" rows="5" placeholder="Ihre Nachricht" aria-label="Ihre Nachricht" class={`${field} resize-y`}></textarea>

        <label for="yeo-privacy" class="flex items-start gap-3 pt-1 cursor-pointer">
          <input type="checkbox" id="yeo-privacy" name="privacy" required class="mt-0.5 w-5 h-5 shrink-0 rounded border-0 accent-[var(--yeo-accent)]" />
          <span class="text-xs text-white/75 leading-relaxed">
            Ich habe die <a href="/datenschutz" target="_blank" class="underline text-white">Datenschutzerklärung</a> gelesen und willige ein, dass die Pixformance Sports GmbH mich per E-Mail oder Telefon zu diesem Angebot, zu Produkten sowie allgemeinen Unternehmens-Infos kontaktieren darf. Die Einwilligung kann jederzeit widerrufen werden.
          </span>
        </label>
        <p id="yeo-form-error" class="hidden text-red-400 text-sm text-center"></p>

        <button type="submit" class="block mx-auto px-10 py-4 rounded-xl bg-[var(--yeo-accent)] text-[#0b0b0b] font-bold uppercase tracking-wide hover:opacity-90 transition-all cursor-pointer">
          Anfrage senden
        </button>
      </form>

      <div id="yeo-thanks" class="hidden text-center py-10" role="status">
        <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-[var(--yeo-accent)] flex items-center justify-center">
          <svg width="32" height="32" fill="none" stroke="#0b0b0b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <h2 class="font-display text-2xl font-bold mb-2">Vielen Dank für Ihre Anfrage!</h2>
        <p class="text-white/75">Wir melden uns in Kürze mit Ihrem persönlichen Year-End Offer.</p>
      </div>
    </div>

    <footer class="text-center text-xs text-white/50 pb-8">
      <a href="/impressum" class="hover:text-white">Impressum</a> · <a href="/datenschutz" class="hover:text-white">Datenschutzerklärung</a>
    </footer>
  </div>
</BaseLayout>

<script src="/js/phone-field.js" is:inline></script>
<script is:inline>
(function () {
  var WEBHOOK_URL = 'https://webhook.pixformance.com/webhook/site-forms';
  var FORM_NAME = 'Year-End Offer 2026 - Multi-Step'; // nome mantido: n8n, Zoho e Meta já tratam este valor
  var META_EVENT_ID = '';

  function initEventId() {
    window.dataLayer = window.dataLayer || [];
    for (var i = window.dataLayer.length - 1; i >= 0; i--) {
      if (window.dataLayer[i] && window.dataLayer[i].event_id) {
        META_EVENT_ID = window.dataLayer[i].event_id;
        return;
      }
    }
    META_EVENT_ID = Date.now() + '_' + Math.floor(Math.random() * 1e15);
    window.dataLayer.push({ event: 'meta_event_id_ready', event_id: META_EVENT_ID });
  }

  // SHA-256 via Web Crypto API, com a normalização que o Meta exige (lowercase + trim).
  function sha256(value) {
    var normalized = (value || '').toLowerCase().trim();
    var encoded = new TextEncoder().encode(normalized);
    return crypto.subtle.digest('SHA-256', encoded).then(function (buffer) {
      return Array.from(new Uint8Array(buffer))
        .map(function (b) { return b.toString(16).padStart(2, '0'); })
        .join('');
    });
  }

  function normalizePhone(phone) {
    var cleaned = (phone || '').trim().replace(/[\s\-().]/g, '');
    if (cleaned && !cleaned.startsWith('+')) {
      cleaned = '+49' + cleaned.replace(/^0/, '');
    }
    return cleaned;
  }

  // Um campo só de nome, como no concorrente. n8n e Zoho esperam first_name/last_name:
  // a última palavra vira sobrenome; nome de uma palavra só vai inteiro em last_name,
  // porque o Zoho exige Last Name.
  function splitName(full) {
    var parts = (full || '').trim().split(/\s+/).filter(Boolean);
    if (parts.length < 2) return { first: '', last: parts[0] || '' };
    return { first: parts.slice(0, -1).join(' '), last: parts[parts.length - 1] };
  }

  function getUrlParams() {
    var params = {};
    new URLSearchParams(window.location.search).forEach(function (v, k) { params[k] = v; });
    return params;
  }

  function getCookies() {
    var cookies = {};
    if (!document.cookie) return cookies;
    document.cookie.split(';').forEach(function (c) {
      var i = c.indexOf('=');
      if (i === -1) return;
      var k = c.slice(0, i).trim();
      var v = c.slice(i + 1).trim();
      try { cookies[k] = decodeURIComponent(v); } catch (e) { cookies[k] = v; }
    });
    return cookies;
  }

  function getFbc(cookies) {
    var fbclid = new URLSearchParams(window.location.search).get('fbclid');
    if (fbclid) {
      var subdomainIndex = window.location.hostname.startsWith('www.') ? 2 : 1;
      return 'fb.' + subdomainIndex + '.' + Date.now() + '.' + fbclid;
    }
    return cookies._fbc || '';
  }

  function sanitizePhone(phone) {
    return (phone || '').replace(/[^\d\s+\-()]/g, '').trim();
  }

  function showThanks(form) {
    form.classList.add('hidden');
    document.getElementById('yeo-thanks').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  async function submitForm(form) {
    var fd = new FormData(form);
    var errEl = document.getElementById('yeo-form-error');
    errEl.classList.add('hidden');

    // Honeypot do form-protection.js: robô recebe sucesso falso.
    if ((fd.get('_fax_number') || '').length > 0 || (fd.get('website') || '').length > 0) {
      showThanks(form);
      return;
    }

    var name = splitName(fd.get('name'));
    var cookies = getCookies();
    var fbc = getFbc(cookies);
    if (fbc) cookies._fbc = fbc;
    var fbp = cookies._fbp || '';

    var btn = form.querySelector('[type="submit"]');
    btn.disabled = true; btn.style.opacity = '0.7';

    var hashed = ['', '', '', ''];
    try {
      hashed = await Promise.all([
        fd.get('email') ? sha256(fd.get('email')) : '',
        fd.get('phone') ? sha256(normalizePhone(fd.get('phone'))) : '',
        name.first ? sha256(name.first) : '',
        name.last ? sha256(name.last) : '',
      ]);
    } catch (e) {}

    var pixConsent = null;
    try { pixConsent = JSON.parse(localStorage.getItem('pix_consent') || 'null'); } catch (e) {}
    if (pixConsent && pixConsent.marketing) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'meta_user_data_ready', em: hashed[0], ph: hashed[1], fn: hashed[2], ln: hashed[3] });
    }

    try {
      var r = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          form_name: FORM_NAME,
          company: fd.get('company') || '',
          first_name: name.first,
          last_name: name.last,
          email: fd.get('email') || '',
          phone: sanitizePhone(fd.get('phone')),
          message: fd.get('message') || '',
          privacy_accepted: fd.get('privacy') === 'on',
          page_url: window.location.href,
          page_path: window.location.pathname,
          referrer: document.referrer || '',
          submitted_at: new Date().toISOString(),
          url_params: getUrlParams(),
          cookies: cookies,
          language: 'de',
          version: 'DACH',
          form_source: 'landing-page',
          meta_event_id: META_EVENT_ID,
          meta_fbp: fbp,
          meta_fbc: fbc,
          meta_user_agent: navigator.userAgent,
          meta_event_source_url: window.location.href,
          meta_em: hashed[0],
          meta_ph: hashed[1],
          meta_fn: hashed[2],
          meta_ln: hashed[3],
        }),
      });
      if (r && r.ok) { showThanks(form); return; }
      throw new Error('status ' + (r && r.status));
    } catch (e) {
      errEl.textContent = 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut.';
      errEl.classList.remove('hidden');
    } finally {
      btn.disabled = false; btn.style.opacity = '';
    }
  }

  function init() {
    initEventId();

    var term = new URLSearchParams(window.location.search).get('utm_term') || '';
    if (term === 'header-2') document.getElementById('yeo').style.setProperty('--yeo-accent', '#E9C45D');

    var composePhone = window.PixPhoneField ? window.PixPhoneField.init('yeo', { locale: 'de' }) : null;
    var form = document.getElementById('yeo-form');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      if (composePhone && !composePhone()) { document.getElementById('yeo-number').focus(); return; }
      submitForm(form);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
